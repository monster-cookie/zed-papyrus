{
  "name": "zed-papyrus-development",
  "private": true,
  "type": "module",
  "scripts": {
    "grammar:generate": "tree-sitter generate --abi 15 --output grammar/src grammar/grammar.js",
    "grammar:build": "tree-sitter build --wasm grammar --output grammar/papyrus.wasm",
    "grammar:test": "node scripts/test-grammar.mjs",
    "grammar:test:native": "tree-sitter test --grammar-path grammar",
    "grammar:parse": "tree-sitter parse --grammar-path grammar"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.11",
    "web-tree-sitter": "0.26.11"
  }
}
